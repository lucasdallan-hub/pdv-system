{
  "name": "pdv-system",
  "version": "1.3.0",
  "description": "Sistema de PDV com Controle Financeiro e Integração WhatsApp",
  "main": "backend/index.js",
  "scripts": {
    "start": "npm install:all && npm run build && node backend/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon backend/index.js",
    "client": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ..",
    "heroku-postbuild": "npm run install:all && npm run build",
    "setup": "node setup.js",
    "seed": "node backend/scripts/seed-data.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.5.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.11.1",
    "nodemailer": "^6.9.6",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
