# PDV System Configuration

# Server
PORT=5000
NODE_ENV=development

# Wuzapi Configuration
WUZAPI_URL=https://api.nxsplus.xyz
WUZAPI_TOKEN=seu_token_aqui
WUZAPI_INSTANCE=sua_instancia_aqui

# Database
DATABASE_PATH=./backend/database/pdv.db

# Frontend
REACT_APP_API_URL=http://localhost:5000/api

# NFS-e Nacional (API oficial do ADN — acesso por certificado digital)
# Caminho do seu e-CNPJ A1 (.pfx). NUNCA comite esse arquivo.
NFSE_CERT_PATH=./certificados/ecnpj.pfx
NFSE_CERT_PASSWORD=senha_do_certificado
# producao | homologacao
NFSE_AMBIENTE=producao
# CNPJ a consultar (apenas dígitos). Precisa ter a mesma raiz do certificado.
NFSE_CNPJ=
NFSE_TIMEOUT_MS=60000
# Só use "false" para diagnosticar cadeia ICP-Brasil; deixe ligado em produção.
NFSE_TLS_STRICT=true
